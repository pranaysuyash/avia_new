# Dockerfile for AI Model Management Service
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install additional ML dependencies
RUN pip install \
    torch \
    transformers \
    optuna \
    mlflow \
    wandb \
    onnx \
    onnxruntime \
    boto3

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p models model_cache

# Run AI model management service
CMD ["python", "-c", "import asyncio; from ai_model_management_system import demo_model_management; asyncio.run(demo_model_management())"]