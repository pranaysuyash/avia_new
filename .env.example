# ============================================================================
# COMPREHENSIVE TRANSCRIPTION PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================================================

# ===========================================
# CORE APPLICATION SETTINGS
# ===========================================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# ===========================================
# API KEYS AND SECRETS
# ===========================================

# OpenAI Configuration (Required for transcription)
OPENAI_API_KEY=your-openai-api-key-here

# ElevenLabs Configuration (Required for text-to-speech)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# JWT Secret Key (minimum 32 characters)
JWT_SECRET_KEY=your-jwt-secret-key-minimum-32-characters-long

# Security Keys
SECURITY_MASTER_KEY=your-master-key-here
STREAMLIT_SERVER_COOKIE_SECRET=your-cookie-secret-here
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=transcription_db
POSTGRES_USER=transcription_user
POSTGRES_PASSWORD=transcription_pass
DATABASE_URL=postgresql://transcription_user:transcription_pass@localhost:5432/transcription_db

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_URL=redis://localhost:6379/0
DISABLE_REDIS=false

# ===========================================
# APPLICATION PORTS
# ===========================================

# Main Services
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
ANALYTICS_PORT=8502

# CORS Configuration for Frontend Development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3003,http://localhost:5173

# Monitoring Services
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
EMAIL_FROM=noreply@transcription-platform.com

# ===========================================
# CLOUD STORAGE
# ===========================================

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=your-s3-bucket-name

# MinIO Configuration (Local Development)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# ===========================================
# AI MODEL SETTINGS
# ===========================================
WHISPER_MODEL_SIZE=base
MODEL_CACHE_DIR=./models

# ===========================================
# FEATURE FLAGS
# ===========================================
ENABLE_ANALYTICS_DASHBOARD=true
ENABLE_MODEL_MANAGEMENT=true
ENABLE_MEDICAL_COMPLIANCE=true
ENABLE_REAL_TIME_COLLABORATION=true

# ===========================================
# PERFORMANCE SETTINGS
# ===========================================
MAX_FILE_SIZE_MB=500
TRANSCRIPTION_TIMEOUT_SECONDS=1800
RATE_LIMIT_PER_MINUTE=60

# ===========================================
# MONITORING
# ===========================================
ENABLE_METRICS=true
SENTRY_DSN=your-sentry-dsn-url

# ===========================================
# COMPLIANCE
# ===========================================
ENABLE_HIPAA_LOGGING=true
DATA_RETENTION_DAYS=2555