      "h3": "Subsections",
      "h4": "Sub-subsections",
      "h5": "Minor headings",
      "h6": "Lowest level headings"
    },
    "ariaLabels": {
      "required": "Required field",
      "invalid": "Invalid input",
      "expanded": "Expanded",
      "collapsed": "Collapsed",
      "loading": "Loading content",
      "close": "Close dialog"
    }
  },
  "motionPreferences": {
    "reducedMotion": {
      "animations": "none",
      "transitions": "0.3s ease"
    },
    "respectUserPreferences": true,
    "fallbacks": {
      "autoplay": false,
      "parallax": false,
      "carousel": "pause"
    }
  },
  "internationalization": {
    "rtlSupport": true,
    "fontStack": {
      "latin": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "arabic": "'Noto Sans Arabic', system-ui, sans-serif",
      "chinese": "'Noto Sans SC', system-ui, sans-serif",
      "japanese": "'Noto Sans JP', system-ui, sans-serif",
      "korean": "'Noto Sans KR', system-ui, sans-serif"
    },
    "numberFormats": {
      "decimal": "locale-specific",
      "currency": "locale-specific",
      "percentage": "locale-specific"
    }
  },
  "components": {
    "button": {
      "minHeight": "44px",
      "minWidth": "44px",
      "padding": "8px 16px",
      "aria": {
        "label": "descriptive text",
        "describedby": "additional context",
        "pressed": "toggle state"
      }
    },
    "input": {
      "minHeight": "44px",
      "label": "always visible",
      "aria": {
        "label": "field purpose",
        "describedby": "help text",
        "required": "required fields",
        "invalid": "error state"
      }
    },
    "modal": {
      "focus": "trap focus inside",
      "escape": "close on escape",
      "backdrop": "close on backdrop click",
      "aria": {
        "modal": "true",
        "labelledby": "modal title",
        "describedby": "modal content"
      }
    },
    "table": {
      "headers": "th elements with scope",
      "caption": "describe table purpose",
      "aria": {
        "rowcount": "total rows",
        "colcount": "total columns",
        "sort": "sorting state"
      }
    }
