  "testing": {
    "automated": [
      "axe-core",
      "lighthouse",
      "pa11y"
    ],
    "manual": [
      "keyboard navigation",
      "screen reader testing",
      "color contrast validation",
      "zoom testing (up to 200%)"
    ],
    "tools": {
      "screenReaders": ["NVDA", "JAWS", "VoiceOver", "TalkBack"],
      "browsers": ["Chrome", "Firefox", "Safari", "Edge"],
