{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/pipeline-template.schema.json",
  "title": "Pipeline Template",
  "type": "object",
  "required": ["id", "name", "version", "dag"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 3},
    "name": {"type": "string", "minLength": 3},
    "version": {"type": "string", "pattern": "^(\\d+)\\.(\\d+)\\.(\\d+)$"},
    "description": {"type": "string"},
    "io": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": {"type": "string"},
              "type": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": {"type": "string"},
              "type": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      }
    },
    "parameters": {"type": "object"},
    "parameters_schema": {"type": "object"},
    "dag": {
      "type": "object",
      "required": ["nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "def"],
            "additionalProperties": true,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "def": {"type": "string", "minLength": 1},
              "params": {"type": "object"},
              "io": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "in": {"type": "array", "items": {"type": "string"}},
                  "out": {"type": "array", "items": {"type": "string"}}
                }
              },
              "ui": {"type": "object"}
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": false,
            "properties": {
              "from": {"type": "string", "minLength": 1},
              "to": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "checks", "severity"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string", "enum": ["info", "warn", "block"]},
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {"type": "string"},
                "node": {"type": "string"},
                "p95_ms": {"type": "number"}
              },
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}

